{
  "name": "@gravity-ui/chartkit",
  "version": "8.12.0",
  "description": "Plugin-based React component that renders charts from multiple charting libraries, such as Gravity Charts and Yagr, through a single ChartKit API, with mobile-friendly tooltips and custom plugin support",
  "keywords": [
    "charts",
    "chart",
    "charting",
    "data-visualization",
    "dataviz",
    "react",
    "react-component",
    "typescript",
    "gravity-ui",
    "chartkit",
    "yagr"
  ],
  "homepage": "https://github.com/gravity-ui/ChartKit#readme",
  "license": "MIT",
  "repository": "git@github.com:gravity-ui/ChartKit.git",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/cjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./gravity-charts": {
      "import": {
        "types": "./build/esm/plugins/gravity-charts/index.d.ts",
        "default": "./build/esm/plugins/gravity-charts/index.js"
      },
      "require": {
        "types": "./build/cjs/plugins/gravity-charts/index.d.ts",
        "default": "./build/cjs/plugins/gravity-charts/index.js"
      }
    },
    "./highcharts": {
      "import": {
        "types": "./build/esm/plugins/highcharts/index.d.ts",
        "default": "./build/esm/plugins/highcharts/index.js"
      },
      "require": {
        "types": "./build/cjs/plugins/highcharts/index.d.ts",
        "default": "./build/cjs/plugins/highcharts/index.js"
      }
    },
    "./indicator": {
      "import": {
        "types": "./build/esm/plugins/indicator/index.d.ts",
        "default": "./build/esm/plugins/indicator/index.js"
      },
      "require": {
        "types": "./build/cjs/plugins/indicator/index.d.ts",
        "default": "./build/cjs/plugins/indicator/index.js"
      }
    },
    "./yagr": {
      "import": {
        "types": "./build/esm/plugins/yagr/index.d.ts",
        "default": "./build/esm/plugins/yagr/index.js"
      },
      "require": {
        "types": "./build/cjs/plugins/yagr/index.d.ts",
        "default": "./build/cjs/plugins/yagr/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "./build/cjs/index.d.ts"
      ],
      "gravity-charts": [
        "./build/cjs/plugins/gravity-charts/index.d.ts"
      ],
      "highcharts": [
        "./build/cjs/plugins/highcharts/index.d.ts"
      ],
      "indicator": [
        "./build/cjs/plugins/indicator/index.d.ts"
      ],
      "yagr": [
        "./build/cjs/plugins/yagr/index.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "!**/__tests__/**",
    "!**/__stories__/**",
    "!**/mocks/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "dependencies": {
    "@bem-react/classname": "^1.6.0",
    "@gravity-ui/charts": "^2.0.0",
    "@gravity-ui/date-utils": "^2.1.0",
    "@gravity-ui/i18n": "^1.0.0",
    "@gravity-ui/yagr": "^5.0.0",
    "afterframe": "^1.0.2",
    "es-toolkit": "^1.53.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@gravity-ui/eslint-config": "^4.2.1",
    "@gravity-ui/gulp-utils": "^1.2.0",
    "@gravity-ui/prettier-config": "^1.1.0",
    "@gravity-ui/readme-validator": "^1.3.0",
    "@gravity-ui/stylelint-config": "^4.0.1",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@gravity-ui/uikit": "^8.0.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.7",
    "@storybook/react": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@types/d3": "^7.4.0",
    "@types/d3-selection": "^3.0.10",
    "@types/node": "^18.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-storybook": "^10.2.16",
    "globals": "^17.4.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-dart-sass": "^1.0.2",
    "highcharts": "^8.2.2",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.2",
    "prettier": "^3.2.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^5.0.5",
    "sass": "^1.56.2",
    "storybook": "^10.2.0",
    "stylelint": "^15.11.0",
    "ts-node": "^10.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "peerDependencies": {
    "@gravity-ui/uikit": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:unit": "vitest run --project unit",
    "test:visual": "vitest run --project visual",
    "test:docker": "./scripts/playwright-docker.sh npm run test:visual --",
    "test:docker:update": "./scripts/playwright-docker.sh npm run test:visual -- --update",
    "test:docker:clear-cache": "./scripts/playwright-docker.sh clear-cache",
    "test:build": "node scripts/check-build.mjs",
    "clean": "gulp clean",
    "start": "storybook dev -p 7007",
    "build": "gulp",
    "build:docs": "gulp copy-docs",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:styles": "cross-env stylelint '{styles,src}/**/*.scss'",
    "lint:styles:fix": "cross-env npm run lint:styles -- --fix",
    "lint:prettier": "cross-env prettier --check '**/*.md'",
    "lint:prettier:fix": "cross-env prettier --write '**/*.md'",
    "lint": "run-p lint:*",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build-storybook": "storybook build -o storybook-static"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{css,scss}": [
      "stylelint --fix --quiet",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ]
  }
}
